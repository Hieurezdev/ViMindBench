OPENAI_BASE_URL=https://silver-pots-jog.loca.lt/v1
START_INDEX=15068
END_INDEX=0
# ===== Embedding Configuration =====
# Local embedding server (e.g., LM Studio)
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# MongoDB Configuration
MONGO_URI=mongodb+srv://nguyenphamtrunghieu277_db_user:hieudevdut@cluster0.kf8srgq.mongodb.net/
MONGO_DB_NAME=Data
MONGO_COLLECTION_NAME=mental

# Data Directory

# ===== Evidence-gated MCQ pipeline =====
# mental is Tier 2 after running the explicit backfill command documented in README.
MONGO_DSM5_COLLECTION_NAME=DSM-5
ALLOW_UNTIERED_EVIDENCE=true

# Configure a model endpoint; --model_local overrides this with localhost:8000/v1.
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507
USE_LOCAL_EMBEDDING=true

# Generation and output
NUM_QA_PAIRS=100
OUTPUT_PATH=data/output/psychology_mcq.jsonl
DATA_SPLIT=train
PLAYBOOK_VERSION=v0.2
PLAYBOOK_REPEAT_THRESHOLD=3

# Set to false only after all mental documents are labelled source_tier=tier_2.
# ALLOW_UNTIERED_EVIDENCE=false

# Import-only source metadata
SOURCE_TIER=tier_2
DATA_DIR=data/tram_cam
