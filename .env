OPENAI_BASE_URL=https://silver-pots-jog.loca.lt/v1
START_INDEX=15068
END_INDEX=0
# ===== Embedding Configuration =====
# Local embedding server (e.g., LM Studio)
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=BAAI/bge-m3

# MongoDB Configuration
MONGO_URI=mongodb+srv://nguyenphamtrunghieu277_db_user:hieudevdut@cluster0.kf8srgq.mongodb.net/
MONGO_DB_NAME=Data
MONGO_COLLECTION_NAME=mental

# Tier 1 textbook corpus. Kept separate from the Tier 2 mental collection.
# Set this only in an untracked local environment or as a shell/Colab secret.
TIER1_MONGO_URI=mongodb+srv://nguyenphamtrunghieu277_db_user:0M2KKuxayjBOoMPU@gtrinh.tp8xkob.mongodb.net/
TIER1_MONGO_DB_NAME=gtrinh
TIER1_MONGO_COLLECTION_NAME=gtrinh
TIER1_MONGO_VECTOR_INDEX=vector_index
TIER1_MONGO_TEXT_INDEX=atlas_index
TIER1_RETRIEVAL_K=5
TIER1_QUERY_CONTEXT_CHARS=900

# Data Directory

# ===== Evidence-gated MCQ pipeline =====
# mental is Tier 2 after running the explicit backfill command documented in README.
MONGO_DSM5_COLLECTION_NAME=DSM-5
ALLOW_UNTIERED_EVIDENCE=true

# Configure a model endpoint; --model_local overrides this with localhost:8000/v1.
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# Gemini is used only by A04–A07 judges.
JUDGE_OPENAI_BASE_URL=http://localhost:8081/v1
JUDGE_OPENAI_API_KEY=EMPTY
JUDGE_MODEL_NAME=gemini-3.6-flash

# A09 Notebook insight model. Set INSIGHT_MODEL_NAME to the exact ID served at
# http://localhost:8001/v1/models; otherwise the primary MODEL_NAME is used.
INSIGHT_OPENAI_BASE_URL=http://localhost:8001/v1
INSIGHT_OPENAI_API_KEY=EMPTY
USE_LOCAL_EMBEDDING=true

# Generation and output
NUM_QA_PAIRS=100
OUTPUT_PATH=data/output/psychology_mcq.jsonl
OUTPUT_FLUSH_INTERVAL=5
DATA_SPLIT=train
PLAYBOOK_VERSION=v0.2
PLAYBOOK_REPEAT_THRESHOLD=3
MAX_GENERATION_RETRIES=2
LOG_LEVEL=INFO
# LOG_PATH=data/output/psychology_mcq.run.log

# Set to false only after all mental documents are labelled source_tier=tier_2.
# ALLOW_UNTIERED_EVIDENCE=false
PLAYBOOK_BULLET_MERGE_ENABLED=true
PLAYBOOK_MERGE_SIMILARITY_THRESHOLD=0.88
PLAYBOOK_MERGE_MAX_PAIRS=1
# Import-only source metadata
SOURCE_TIER=tier_2
DATA_DIR=data/tram_cam
# DATA_DIR=data/formated_data_tam_li_voi_cuoc_song
A03_HARD_GUARD_ENABLED=true
A03_HARD_MAX_OPTION_WORD_GAP=5
LANGGRAPH_MAX_CONCURRENCY=4
RETRIEVER_CACHE_SIZE=512
A07_ADVERSARIAL_BLOCKING=false
A07_MAX_OPTION_WORD_GAP=8
A07_HARD_MAX_OPTION_WORD_GAP=5