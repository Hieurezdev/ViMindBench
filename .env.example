
# ===== MongoDB Configuration =====
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/
MONGO_DB_NAME=Data
MONGO_COLLECTION_NAME=mental

# ===== LLM Configuration =====
# Option 1: Use OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Option 2: Use Custom Endpoint (vLLM, Ollama, LM Studio, etc.)
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY
# MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# ===== Embedding Configuration =====
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=namdp-ptit/ViDense

# ===== Pipeline Configuration =====
NUM_QA_PAIRS=5000
START_INDEX=0
END_INDEX=0

# Output path (relative to project root)
OUTPUT_PATH=data/output/generated_psychology_multiple_choice.jsonl
