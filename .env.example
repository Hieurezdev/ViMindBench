# Copy this file to .env and replace placeholder values. Never commit .env.

# ── MongoDB sources ────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=Data
MONGO_COLLECTION_NAME=mental
MONGO_DSM5_COLLECTION_NAME=DSM-5

# Primary textbook evidence. Tier 1 is retrieved first; its passages expand
# the query used to retrieve related Tier 2 material from `mental` above.
# TIER1_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
TIER1_MONGO_DB_NAME=gtrinh
TIER1_MONGO_COLLECTION_NAME=gtrinh
TIER1_MONGO_VECTOR_INDEX=vector_index
TIER1_MONGO_TEXT_INDEX=atlas_index
TIER1_RETRIEVAL_K=2
TIER1_QUERY_CONTEXT_CHARS=900

# The mental collection is an approved Tier 2 source after it has been
# backfilled: uv run python test/backfill_source_tier.py --collection mental --source-tier tier_2 --apply
# Keep true until that migration is complete; then set false to enforce Tier 1/2.
ALLOW_UNTIERED_EVIDENCE=true

# ── LLM endpoint ───────────────────────────────────────────────────────────
# Hosted OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=<secret>
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# Optional separate LLM-as-judge endpoint for A04–A07.
# Gemini web2api example: http://localhost:8081/v1 / gemini-3.6-flash / EMPTY
# When omitted, judges fall back to OPENAI_BASE_URL and MODEL_NAME above.
# JUDGE_OPENAI_BASE_URL=http://localhost:8081/v1
# JUDGE_OPENAI_API_KEY=EMPTY
# JUDGE_MODEL_NAME=gemini-3.6-flash

# Optional A09 Notebook insight endpoint. It is called only when a new
# recurring issue reaches PLAYBOOK_REPEAT_THRESHOLD; otherwise no request is made.
# INSIGHT_OPENAI_BASE_URL=http://localhost:8001/v1
# INSIGHT_OPENAI_API_KEY=EMPTY
# INSIGHT_MODEL_NAME=<served-insight-model-id>

# For a local vLLM/LM Studio endpoint, use --model_local or uncomment:
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY

# ── Embeddings ─────────────────────────────────────────────────────────────
# true: load SentenceTransformer locally. false: call EMBEDDING_BASE_URL.
USE_LOCAL_EMBEDDING=true
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# In-memory LRU entries for normalized embeddings and retrieval queries per run.
RETRIEVER_CACHE_SIZE=512

# ── Generation and output ──────────────────────────────────────────────────
NUM_QA_PAIRS=100
OUTPUT_PATH=data/output/psychology_mcq.jsonl
OUTPUT_FLUSH_INTERVAL=5
# Persist playbook, failure memory, and judge-memory sidecars after this many completed items.
LEARNING_CHECKPOINT_INTERVAL=10
DATA_SPLIT=train
PLAYBOOK_VERSION=v0.2
PLAYBOOK_REPEAT_THRESHOLD=3
MAX_GENERATION_RETRIES=2
# Run one A03 evidence/surface-cue preflight and repair once before A04–A07.
A03_PREFLIGHT_ENABLED=true
# Hard items are deterministically rewritten for large length gaps or emphatic wording.
A03_HARD_GUARD_ENABLED=true
A03_HARD_MAX_OPTION_WORD_GAP=5
# true: hard A03 evidence planning and MCQ generation use JUDGE_* (with primary fallback).
HARD_GENERATION_USE_JUDGE=false
# Allows A04, A05, A07, and DSM-5 retrieval branches to run concurrently.
LANGGRAPH_MAX_CONCURRENCY=4
LOG_LEVEL=INFO
# LOG_PATH=data/output/psychology_mcq.run.log

# Only used by the legacy pipeline; retained for compatibility.
START_INDEX=0
END_INDEX=0

# Only used by test/import_json_to_mongodb.py.
DATA_DIR=data/formated_data
SOURCE_TIER=tier_2
